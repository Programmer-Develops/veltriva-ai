# ============================================================================
# VELTRIVA AI — Environment Configuration (.env)
# ============================================================================
PORT=4000
JWT_SECRET=veltriva_super_secret_jwt_key_2026_fintech

# Database Configuration
# Leave DATABASE_URL blank to use the built-in real PostgreSQL 16 (PGlite WASM)
# Or provide a Render / Neon / Local PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/veltriva_ai
DATABASE_URL= 

# PayPal Developer Sandbox Credentials (https://developer.paypal.com)
# If left blank, Veltriva AI runs in RFC-compliant PayPal Sandbox Simulation Mode
# You can also enter your live Sandbox Client ID & Secret directly in the UI!
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional AI LLM Key (Gemini or OpenAI) for enhanced natural-language copilot
# Built-in ML & Deterministic AI Treasury Agent works 100% without external keys
GEMINI_API_KEY=
OPENAI_API_KEY=
